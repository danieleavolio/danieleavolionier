{
	"name": "danieleavolio",
	"version": "1.0.0",
	"private": false,
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:preview": "node scripts/build-preview.mjs",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:quick": "npm run check && npm test",
		"check:full": "npm run check:quick && npm run lint:code && npm run build && node scripts/verify-build.mjs && npm run test:e2e",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "node --test tests/content.test.mjs",
		"test:e2e": "playwright test",
		"assets:optimize": "node scripts/optimize-assets.mjs",
		"audit:capture": "node scripts/capture-site.mjs",
		"audit:verify": "node scripts/verify-site.mjs",
		"lint": "prettier --check . && eslint .",
		"lint:code": "eslint src tests scripts",
		"format": "prettier --write .",
		"prepare": "husky install",
		"postinstall": "patch-package --error-on-fail",
		"new:post": "node scripts/new-content.mjs post",
		"new:project": "node scripts/new-content.mjs project",
		"migrate:content": "node scripts/migrate_to_supabase.js"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.1",
		"@sveltejs/adapter-vercel": "7.0.3",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^25.3.5",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.15.0",
		"globals": "^16.5.0",
		"husky": "^8.0.3",
		"lint-staged": "^15.5.2",
		"mdsvex": "^0.12.8",
		"patch-package": "^8.0.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"sharp": "^0.35.5",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tslib": "^2.4.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.0.14"
	},
	"type": "module",
	"dependencies": {
		"@fontsource/jetbrains-mono": "^5.0.8",
		"@fontsource/manrope": "^5.0.8",
		"@fontsource/pt-serif": "^5.3.0",
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0",
		"@tiptap/core": "^3.34.0",
		"@tiptap/extension-image": "^3.34.0",
		"@tiptap/extension-link": "^3.34.0",
		"@tiptap/extension-placeholder": "^3.34.0",
		"@tiptap/extension-underline": "^3.34.0",
		"@tiptap/pm": "^3.34.0",
		"@tiptap/starter-kit": "^3.34.0",
		"@types/sanitize-html": "^2.16.1",
		"dotenv": "^17.4.2",
		"flexsearch": "^0.7.43",
		"i": "^0.3.7",
		"lucide-svelte": "^0.577.0",
		"marked": "^18.2.0",
		"mermaid": "^12.3.0",
		"open-props": "^1.5.11",
		"pele": "^1.13.0",
		"rehype-slug": "^5.1.0",
		"remark-toc": "^8.0.1",
		"remark-unwrap-images": "^3.0.1",
		"sanitize-html": "^2.18.2",
		"shiki": "^0.14.3"
	},
	"lint-staged": {
		"src/**/*.{js,jsx,ts,tsx,svelte,json,css,scss,md}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=22.17"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
